# DevCage local configuration template.
# Copy to local.env and adjust. Do not commit secrets in local.env.
#
#   cp local.env.example local.env
#
# Load in a shell session (optional):
#   set -a && source local.env && set +a
#
# Prefer relative paths from the repo root, or variables expanded at runtime.
# Do not hardcode machine-specific absolute paths in committed files.

# --- Logging ---
# RUST_LOG=info
# DEVCAGE_LOG=warn

# --- Paths (override only when needed; tools should detect project root) ---
# DEVCAGE_WORKSPACE=.
# DEVCAGE_CONFIG_DIR=          # default: $XDG_CONFIG_HOME/devcage or ~/.config/devcage
# DEVCAGE_DATA_DIR=            # session volumes / durable cages (backend-specific)
# DEVCAGE_CACHE_DIR=

# --- Defaults for agent happy path ---
# DEVCAGE_DEFAULT_PROFILE=agent    # agent | offline | host
# DEVCAGE_DEFAULT_AGENT=claude     # command name inside the container image

# --- Container backend ---
# DEVCAGE_CONTAINER_RUNTIME=       # docker | podman (default: first found)
# DEVCAGE_CONTAINER_IMAGE=docker.io/library/alpine:3.20
# DEVCAGE_DATA_DIR=                # default: $XDG_DATA_HOME/devcage or ~/.local/share/devcage
# DEVCAGE_SHARE_PACKAGE_CACHES=0   # 1 = RO-mount host npm/uv/pip caches when present

# --- Network allowlist (phase 2 only; not claimed in v0.1) ---
# DEVCAGE_NET_ALLOWLIST_FILE=
# DEVCAGE_NET_CATEGORIES_FILE=

# --- Third-party software links (docs / consoles — non-secret) ---
# PKG_GUARD_DOCS_URL=https://github.com/suryan/pkg-guard
# BUBBLEWRAP_DOCS_URL=https://github.com/containers/bubblewrap
# DOCKER_DOCS_URL=https://docs.docker.com
# PODMAN_DOCS_URL=https://docs.podman.io
# D2_DOCS_URL=https://d2lang.com
# RUSTUP_URL=https://rustup.rs

# --- Optional composition with pkg-guard (package policy before install) ---
# PKG_GUARD_BIN=pkg-guard      # must be on PATH or set to a resolvable command name
# DEVCAGE_USE_PKG_GUARD=1

# --- Agent CLI hints (command names only; resolve via PATH inside the cage) ---
# DEVCAGE_AGENT_GROK=grok
# DEVCAGE_AGENT_CLAUDE=claude
# DEVCAGE_AGENT_GEMINI=gemini
